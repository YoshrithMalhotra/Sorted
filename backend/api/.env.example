# Copy to .env (git-ignored) and fill in.

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Must match SORTED_SUPABASE_ANON_KEY in apps/ios/Configs/Local.xcconfig.
# Leave empty on your own machine to accept any caller.
SORTED_CLIENT_KEY=

# Optional overrides.
# SORTED_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded or down (comma separated).
# SORTED_FALLBACK_MODELS=gemini-3.6-flash
# SORTED_THINKING_LEVEL=low
# LOG_LEVEL=INFO
